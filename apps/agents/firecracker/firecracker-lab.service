[Unit]
Description=Firecracker lab worker
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/firecracker-lab/worker.py
Environment=FIRECRACKER_LAB_CLIENT_UID=1000
Environment=FIRECRACKER_LAB_MAX_MACHINES=4
Restart=on-failure
RestartSec=2
UMask=0077
LimitNOFILE=1024
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
